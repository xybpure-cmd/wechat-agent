# =========================
# App
# =========================
APP_NAME=wechat-knowledge-agent
ENVIRONMENT=dev
CONFIDENCE_THRESHOLD=0.55
INTERACTION_LOG_PATH=logs/interactions.jsonl

# =========================
# OpenAI (Required)
# =========================
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_VECTOR_STORE_ID=<your_vector_store_id>

# Optional (default already set in code)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# =========================
# Gewechat
# =========================
# Required for sending reply via Gewechat
GEWECHAT_API_BASE=https://your-gewechat-host

# Optional but recommended
GEWECHAT_TOKEN=<your_gewechat_token>
GEWECHAT_WEBHOOK_SECRET=<shared_secret>

# =========================
# Agent behavior
# =========================
# Required: comma separated user ids allowed to use bot
ALLOWED_CONTACTS=wxid_alice,wxid_bob

# =========================
# KB upload script
# =========================
# Optional path for incremental upload manifest
KB_MANIFEST_PATH=data/.kb_upload_manifest.json
